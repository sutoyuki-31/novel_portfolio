<!-- libraries/show -->
<div class="lib-show-container">

  <!-- タイトルと編集リンクのブロック -->
  <div class="lib-show-title-wrapper">
    <div class="lib-show-title-header">
      <h1 class="lib-show-title">
        <%= @library.title %>
      </h1>
      <!-- ステータスをバッジ・ラベル風に表示 -->
      <% if @library.status.present? %>
        <span class="lib-show-status-badge"><%= @library.status %></span>
      <% end %>
    </div>
    <%= link_to "編集", edit_library_path(@library), class: "lib-show-link-action" %>
  </div>

  <!-- ライブラリの属性情報（ジャンル・キーワード） -->
  <div class="lib-show-meta-wrapper">
    <div class="lib-show-meta-item">
      <span class="lib-show-meta-label">ジャンル</span>
      <span class="lib-show-meta-value"><%= @library.genre.presence || "未設定" %></span>
    </div>
    <div class="lib-show-meta-item">
      <span class="lib-show-meta-label">キーワード</span>
      <span class="lib-show-meta-value"><%= @library.tag.presence || "未設定" %></span>
    </div>
  </div>

  <!-- あらすじのブロック -->
  <div class="lib-show-synopsis-wrapper">
    <h2 class="lib-show-heading">あらすじ</h2>
    <%= simple_format(h(@library.synopsis), class: "lib-show-synopsis") %>
  </div>

  <!-- 話数の一覧ブロック -->
  <h2 class="lib-show-heading">話数の一覧</h2>

  <% if @novels.any? %>
    <ul class="lib-show-list">
      <% @novels.each do |novel| %>
        <li class="lib-show-item">
          <%= link_to novel.subtitle, edit_library_novel_path(@library, novel), class: "lib-show-link-main" %>
          <!-- 安全でスタイルの崩れない button_to に変更 -->
          <%= button_to "削除", library_novel_path(@library, novel), 
                        method: :delete,
                        data: { turbo_confirm: "本当に削除しますか？" }, 
                        class: "lib-show-link-danger" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="lib-show-empty">編集できる小説がありません。</p>
  <% end %>

  <div class="lib-show-actions">
    <%= link_to "新規作成", new_library_novel_path(@library), class: "lib-show-link-primary" %>
  </div>

</div>
