<!-- 全体を包むコンテナを新設し、ここに余白を持たせます -->
<div class="browse-history-container">
  <%= render "users/user-tag", user: @user %>
  <h1 class="history-page-title">閲覧履歴</h1>

  <div data-controller="browse-history-renderer">
    <!-- 履歴リスト本体 -->
    <div data-browse-history-renderer-target="list">
      <p>履歴を読み込み中...</p>
    </div>

    <!-- 削除ボタン（インラインスタイルを削除し、クラスで余白を管理） -->
    <button data-action="click->browse-history-renderer#clear" class="btn btn-danger btn-clear-history">
      履歴をすべて削除
    </button>
  </div>
</div>
