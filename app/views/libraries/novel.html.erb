
    <tr>
     
      <td><%= @library.title %></td>
      <td><%= @library.synopsis %></td>
     <td> <%= link_to "編集", edit_library_path(@library) %></td>
       
    </tr>
 
<%=form_with(model: @libraries, data: { turbo: false}) do |form| %>

<%= form.label :subtitle, "サブタイトル"%>
<%= form.text_field :subtitle%>

<%= form.label :story, "ストーリー"%>
<%= form.text_field :story%>

<%= form.submit %>
<% end %>