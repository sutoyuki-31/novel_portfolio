
<%=form_with(model: @library, data: { turbo: false}) do |form| %>
<td><%= @library.title %></td>
      <td><%= @library.synopsis %></td>

<%= form.label :subtitle, "サブタイトル"%>
<%= form.text_field :subtitle%>

<%= form.label :story, "ストーリー"%>
<%= form.text_field :story%>

<%= form.submit %>
<% end %>