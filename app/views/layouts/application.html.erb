<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Portfolio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "users", "libraries", "novels", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
 <header class="Header">
  <%# link_to（aタグ）自体にクラスを付与します %>
  <%= link_to root_path, class: "Header-logo" do %>
    <%= image_tag "ChatGPT Image 2026年10月4日 20_54_17.png", class: "Header-logo-img" %>
  <% end %>

  <% if user_signed_in? %>
    <%= link_to "マイホーム", myhome_users_path, class: "Header-list" %>
    <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "Header-list" %>
  <% else %>
    <%= link_to '新規登録', new_user_registration_path, class: "Header-list" %>
    <%= link_to 'ログイン', new_user_session_path, class: "Header-list" %>
   <%= button_to "ゲストログイン", users_guest_sign_in_path, method: :post %>
  <% end %>
</header>

 
    <%= yield %>
  </body>
</html>
