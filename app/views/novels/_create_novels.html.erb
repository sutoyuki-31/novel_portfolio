<%# エラーメッセージの表示 %>
<% if @novel.errors.any? %>
  <div id="error_explanation" class="error-container" role="alert">
    <h2><%= t('errors.template.header', count: @novel.errors.count, model: @novel.model_name.human) %></h2>
    <ul>
      <% @novel.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# フォーム本体 %>
<%= form_with model: [@library, @novel], data: { turbo: false }, class: "novel-form" do |form| %>
  
  <div class="form-group">
    <%= form.label :subtitle, "サブタイトル" %>
    <%= form.text_field :subtitle %>
  </div>

  <%# CSSの指示通り、クラスに「form-group-story」を追加しました %>
  <div class="form-group form-group-story">
    <%= form.label :story, "ストーリー" %>
    <%= form.text_area :story, placeholder: "ここに物語を綴ります..." %>
  </div>

  <div class="form-group">
    <%= form.label :status, "公開ステータス" %>
    <%# 矢印アイコンをCSSで表現するため、セレクトボックスの親に wrapper を配置するのがおすすめです %>
    <div class="select-wrapper">
      <%= form.select :status, Novel.statuses.keys.map { |k| [t("enums.novel.status.#{k}", default: k.humanize), k] } %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit "保存する" %>
  </div>

<% end %>
